{
  "compilerOptions": {
      "baseUrl": ".",
      "paths": {
	"@scripts/*": ["src/playwright/scripts/*"],
	"@municipalities/*": ["src/municipalities/*"]
      },
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "noEmit": true,  
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "exclude":
      [
	"tests/**/*.js",
	"playwright.config.ts"
      ]
  }
}
